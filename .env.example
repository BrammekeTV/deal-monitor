# =============================================================================
# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Required ---------------------------------------------------------------

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord text channel ID where deals will be posted.
# Right-click the channel → "Copy Channel ID" (Developer Mode must be on).
DISCORD_CHANNEL_ID=123456789012345678

# Discord text channel ID for community review of unidentified listings (e.g. #card-review).
# Right-click the channel → "Copy Channel ID" (Developer Mode must be on).
# DISCORD_REVIEW_CHANNEL_ID=123456789012345679

# ---- Optional ---------------------------------------------------------------

# Discord incoming webhook URL (fallback / extra delivery channel).
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Path to the SQLite database file.
# DATABASE_PATH=data/deals.db

# Logging level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# ---- Price comparison (optional) --------------------------------------------

# eBay Finding API – free App ID from https://developer.ebay.com/
# Used to look up recently *sold* eBay listings and compare against Vinted prices.
# EBAY_APP_ID=YourApp-YourApp-PRD-xxxxxxxx-xxxxxxxx

# Cardmarket – no credentials required.
# Prices are scraped directly using a Playwright browser.
# Cardmarket lookups are enabled by default when playwright is installed.
# To disable Cardmarket lookups, set cardmarket.enabled: false in config/config.yaml.
