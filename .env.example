# =============================================================================
# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Required ---------------------------------------------------------------

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord text channel ID where profit alerts will be posted.
# Right-click the channel → "Copy Channel ID" (Developer Mode must be on).
DISCORD_CHANNEL_ID=123456789012345678

# Discord text channel ID for community review of unresolved listings (e.g. #card-review).
# Users reply to bot messages here with the correct Cardmarket URL.
DISCORD_REVIEW_CHANNEL_ID=123456789012345679

# Discord text channel ID for scraping error reports and logs.
DISCORD_LOG_CHANNEL_ID=123456789012345680

# ---- Optional ---------------------------------------------------------------

# Discord server (guild) ID – enables instant slash-command sync on startup.
# Without this, slash commands are synced globally which can take up to 1 hour.
# Right-click your server icon → "Copy Server ID" (Developer Mode must be on).
# DISCORD_GUILD_ID=123456789012345678

# Path to the SQLite database file (default: data/deals.db).
# DATABASE_PATH=data/deals.db

# Logging level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# LOG_LEVEL=INFO
