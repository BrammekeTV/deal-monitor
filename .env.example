# =============================================================================
# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Required ---------------------------------------------------------------

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord text channel ID where deals will be posted.
# Right-click the channel → "Copy Channel ID" (Developer Mode must be on).
DISCORD_CHANNEL_ID=123456789012345678

# ---- Optional ---------------------------------------------------------------

# Discord incoming webhook URL (fallback / extra delivery channel).
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Path to the SQLite database file.
# DATABASE_PATH=data/deals.db

# Logging level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# ---- Price comparison (optional) --------------------------------------------

# eBay Finding API – free App ID from https://developer.ebay.com/
# Used to look up recently *sold* eBay listings and compare against Vinted prices.
# EBAY_APP_ID=YourApp-YourApp-PRD-xxxxxxxx-xxxxxxxx

# Cardmarket MKM API – OAuth 1.0 credentials from:
# https://www.cardmarket.com/en/Magic/Account/SellYourCards/ApiRegistration
# All four values are required together; leave them unset to skip Cardmarket lookups.
# CARDMARKET_APP_TOKEN=your_app_token
# CARDMARKET_APP_SECRET=your_app_secret
# CARDMARKET_ACCESS_TOKEN=your_access_token
# CARDMARKET_ACCESS_TOKEN_SECRET=your_access_token_secret
